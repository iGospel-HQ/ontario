# Copy to .env.local for local development; set the same names in Vercel for production.

# Django API base URL, including the /v1 prefix.
# Local: http://127.0.0.1:8000/v1   Production default: https://api.igospel.ng/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/v1

# Public origin of this site (canonical URLs, sitemap, RSS, Open Graph).
# Production default: https://www.igospel.com.ng
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Shared secret Django sends to /api/revalidate (Django: FRONTEND_REVALIDATE_SECRET).
# Server-only; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REVALIDATE_SECRET=
